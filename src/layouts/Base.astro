---
import { text, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
  title?: string;
  /** Pfad der Seite in der jeweils anderen Sprache (für den Umschalter) */
  altHref?: string;
}

const { lang, title, altHref } = Astro.props;
const t = text[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} – ${t.title}` : t.title;
const nav =
  lang === 'de'
    ? [
        { label: 'Publikationen', href: `${base}/publikationen/` },
        { label: 'Videos', href: `${base}/videos/` },
      ]
    : [
        { label: 'Publications', href: `${base}/en/publications/` },
        { label: 'Videos', href: `${base}/en/videos/` },
      ];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {altHref && <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={new URL(altHref, Astro.site)} />}
  </head>
  <body>
    <header>
      <a class="home" href={lang === 'de' ? `${base}/` : `${base}/en/`}>U. Winkler</a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>)}
        {altHref && <a class="lang" href={altHref} hreflang={lang === 'de' ? 'en' : 'de'}>{t.switchLabel}</a>}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href={`${base}/impressum/`}>{t.imprint}</a>
      <a href={`${base}/datenschutz/`}>{t.privacy}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --fg: #1f2328;
    --muted: #5d6670;
    --accent: #1d5fa8;
    --line: #e3e0d8;
    --card: #ffffff;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15181c;
      --fg: #e7e9ec;
      --muted: #9aa3ad;
      --accent: #7fb3ec;
      --line: #2b3036;
      --card: #1c2025;
    }
  }
  * { box-sizing: border-box; }
  html { font-size: 17px; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
  }
  a { color: var(--accent); }
  header, main, footer { max-width: 46rem; margin: 0 auto; padding: 0 1.25rem; }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  header a { text-decoration: none; }
  .home { color: var(--fg); font-weight: 600; letter-spacing: 0.02em; }
  nav { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; justify-content: flex-end; }
  nav a { font-size: 0.95rem; }
  nav a[aria-current='page'] { color: var(--fg); font-weight: 600; }
  .lang { font-size: 0.9rem; border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.8rem; }
  h1 { font-size: 2.1rem; line-height: 1.2; margin: 0 0 0.25rem; }
  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 2.5rem 0 0.75rem;
  }
  footer {
    display: flex;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  footer a { color: var(--muted); }
</style>
